---

import Layout from '../layouts/layout.astro';

---

<Layout title="Blogs | PIXELMATH">
  <main class="max-w-6xl mx-auto px-10 pt-20 pb-40 bg-[#121417] text-[#D1D5DB]">
    
    <header class="mb-24">
      <div class="h-[2px] w-12 bg-[#FF6B2C] mb-8"></div>
      <h1 class="text-5xl font-medium tracking-tight text-white mb-4">Archive.log</h1>
      <p class="text-slate-500 uppercase text-[10px] tracking-[0.4em]">Index of research and optimization logs</p>
    </header>

    

  </main>
</Layout>

<style>
  /* Ensuring the matte background remains consistent */
  body {
    background-color: #121417;
  }
</style>